void fetchF1Standings() {

  HTTPClient http;

  http.begin("https://api.jolpi.ca/ergast/f1/current/driverstandings.json");

  int httpCode = http.GET();

  if (httpCode == 200) {

    String payload = http.getString();

    DynamicJsonDocument doc(50000);

    deserializeJson(doc, payload);

    JsonArray standings =
      doc["MRData"]["StandingsTable"]
         ["StandingsLists"][0]
         ["DriverStandings"];

    for (int i = 0; i < 5; i++) {

      f1Driver[i] =
        standings[i]["Driver"]["code"]
          .as<String>();

      f1Points[i] =
        standings[i]["points"]
          .as<int>();
    }
  }

  http.end();
}
