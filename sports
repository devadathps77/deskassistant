// ── Button: long press detection ──────────────
enum BtnState { BS_IDLE, BS_PRESSED, BS_LONG_SENT };
BtnState bState = BS_IDLE;
bool bLastRaw = HIGH;
uint32_t bPressT = 0;
#define BTN_LONG_MS 2000

typedef enum {
  BTN_NONE,
  BTN_SINGLE,
  BTN_LONG
} BtnEvent;

int getButtonEvent() {

  bool raw = digitalRead(21);
  uint32_t now = millis();

  int ev = BTN_NONE;

  switch (bState) {

    case BS_IDLE:
      if (raw == LOW && bLastRaw == HIGH) {
        bPressT = now;
        bState = BS_PRESSED;
      }
      break;

    case BS_PRESSED:
      if (raw == HIGH) {
        if (now - bPressT >= 50 &&
            now - bPressT < BTN_LONG_MS)
          ev = BTN_SINGLE;

        bState = BS_IDLE;
      }
      else if (now - bPressT >= BTN_LONG_MS) {
        ev = BTN_LONG;
        bState = BS_LONG_SENT;
      }
      break;

    case BS_LONG_SENT:
      if (raw == HIGH)
        bState = BS_IDLE;
      break;
  }

  bLastRaw = raw;
  return ev;
}
// ── Setup ─────────────────────────────────────
void setup() {
  Serial.begin(115200);
  pinMode(21, INPUT_PULLUP);
  delay(1000);

  tft.init();
  tft.setRotation(3);
  tft.invertDisplay(false);
  tft.fillScreen(BG);
  initColors();

  sprite.setColorDepth(16);
  sprite.createSprite(320, 240);

  showSplash("Connecting to WiFi...", ssid);
  WiFi.begin(ssid, password);
  int a = 0;
  while (WiFi.status() != WL_CONNECTED && a < 30) { delay(500); a++; }

  if (WiFi.status() == WL_CONNECTED) {
    showSplash("Syncing NTP time...", "pool.ntp.org");
    configTime(gmtOffset_sec, daylightOffset, ntpServer);
    struct tm ti; int tr = 0;
    while (!getLocalTime(&ti) && tr < 20) { delay(500); tr++; }

    showSplash("Fetching weather...", "Thrissur, Kerala");
    fetchWeather();
    lastWeatherFetch = millis();

    showSplash("Loading F1 standings...", "api.jolpi.ca");
   fetchF1Standings();
   fetchF1Live();
    lastF1Fetch = millis();

    showSplash("Loading football scores...", "football-data.org");
    fetchFootball();

  } else {
    showSplash("WiFi Failed!", "Check credentials");
    delay(3000);
  }

  tft.fillScreen(BG);
}

// ── Loop ──────────────────────────────────────
void loop() {
  static unsigned long dbg=0;
if(millis()-dbg>5000){
  dbg=millis();
  Serial.println("Loop Running");
}
  struct tm t;
  if (!getLocalTime(&t)) { delay(50); return; }

  uint32_t now = millis();

  // ── Button ──────────────────────────────────
  int ev = getButtonEvent();

  if (ev == BTN_SINGLE) {
    currentScreen = (currentScreen + 1) % 5;
    Serial.printf("[BTN] Screen -> %d\n", currentScreen);
    sprite.fillSprite(TFT_BLACK);
    tft.fillScreen(TFT_BLACK);
  }

  // Long press = force refresh current screen
  if (ev == BTN_LONG) {
    Serial.printf("[BTN] Long press on screen %d\n", currentScreen);
    sprite.fillSprite(TFT_BLACK);
    tft.fillScreen(TFT_BLACK);
    switch (currentScreen) {
      case 0: fetchWeather();      lastWeatherFetch = now; break;
      case 1: fetchFootball();                             break;
      case 3: fetchF1Standings();  lastF1Fetch      = now; break;
    }
  }

  // ── Timed refreshes ─────────────────────────

  // Clock weather (10 min)
  if (now - lastWeatherFetch > WEATHER_INTERVAL) {
    lastWeatherFetch = now;
    fetchWeather();
  }

  // Football: 60s if live match, 5 min otherwise
  {
    bool anyLive = false;
    for (int i = 0; i < fbMatchCount; i++) if (fbMatches[i].isLive) { anyLive=true; break; }
    uint32_t fbInt = anyLive ? FB_INTERVAL_LIVE : FB_INTERVAL_IDLE;
    if (now - lastFbFetch > fbInt) fetchFootball();
  }

  // F1 standings (30 min — was 10s before, fixed)
  if (now - lastF1Fetch > 1800000UL) {
    lastF1Fetch = now;
   fetchF1Standings();
  }


  // ── Draw ────────────────────────────────────
  switch (currentScreen) {
    case 0: drawClock(t);       break;
    case 1: drawFootball(t);    break;
    case 2: drawF1Live(t);      break;
    case 3: drawF1Standings(t); break;
    case 4: drawSportsNews(t);  break;
  }

  delay(50);
}
