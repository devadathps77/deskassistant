void drawFootball(struct tm& t) {
  drawGradientBG(sprite);

  // ── Header bar ───────────────────────────────────────────
  sprite.fillRect(0, 0, 320, 28, tft.color565(10, 10, 35));
  sprite.setTextDatum(MC_DATUM);
  sprite.setTextColor(C_GREEN, tft.color565(10, 10, 35));
  sprite.drawString(fbCompName, 160, 14, 2);
  sprite.drawFastHLine(0, 28, 320, C_PURPLE);

  // WiFi status indicator (top-right of header)
  sprite.setTextDatum(MR_DATUM);
  sprite.setTextColor(
    WiFi.status()==WL_CONNECTED ? C_DIM : C_RED,
    tft.color565(10,10,35));
  sprite.drawString(WiFi.status()==WL_CONNECTED ? "W" : "!", 314, 14, 1);

  // ── Loading / no data ────────────────────────────────────
  if (!fbHasData) {
    sprite.setTextDatum(MC_DATUM);
    sprite.setTextColor(C_DIM, S_BG);
    sprite.drawString("Fetching scores...", 160, 120, 2);
    drawNavDots(sprite, 1);
    sprite.pushSprite(0, 0);
    return;
  }

  // ── No matches today ─────────────────────────────────────
  if (fbMatchCount == 0) {
    sprite.setTextDatum(MC_DATUM);
    sprite.setTextColor(C_DIM, S_BG);
    sprite.drawString("No matches today", 160, 100, 2);
    char upd[24];
    strftime(upd, sizeof(upd), "Checked %H:%M IST", &t);
    sprite.setTextColor(C_DIM, S_BG);
    sprite.drawString(upd, 160, 125, 1);
    sprite.drawString("Next check in 5 min", 160, 145, 1);
    drawNavDots(sprite, 1);
    sprite.pushSprite(0, 0);
    return;
  }

  // ── Match rows ───────────────────────────────────────────
  // Available vertical space: y=30 to y=220 = 190px
  // Divide evenly among matches (max 4)
  int yTop  = 30;
  int yBot  = 220;
  int space = yBot - yTop;
  int rowH  = space / fbMatchCount;   // e.g. 4 matches → 47px each

  for (int i = 0; i < fbMatchCount; i++) {
    FootballMatch& m = fbMatches[i];
    int yRow  = yTop + i * rowH;
    int yCent = yRow + rowH / 2;       // vertical centre of this row

    // ── Live indicator: green left strip ──────────────────
    if (m.isLive) {
      sprite.fillRect(0, yRow + 2, 4, rowH - 4, C_GREEN);
    }

    // ── Home team (left-aligned, x=8) ────────────────────
    sprite.setTextDatum(ML_DATUM);
    sprite.setTextColor(C_WHITE, S_BG);
    sprite.drawString(m.home, 8, yCent - 7, 2);

    // ── Away team (right-aligned, x=312) ─────────────────
    sprite.setTextDatum(MR_DATUM);
    sprite.setTextColor(C_WHITE, S_BG);
    sprite.drawString(m.away, 312, yCent - 7, 2);

    // ── Centre: score or "vs" ─────────────────────────────
    sprite.setTextDatum(MC_DATUM);
    if (m.isLive || m.isFinished) {
      // Show score
      char score[6];
      snprintf(score, sizeof(score), "%d - %d", m.homeScore, m.awayScore);
      sprite.setTextColor(m.isLive ? C_YELLOW : C_WHITE, S_BG);
      sprite.drawString(score, 160, yCent - 7, 2);
    } else {
      // Upcoming: show "vs"
      sprite.setTextColor(C_DIM, S_BG);
      sprite.drawString("vs", 160, yCent - 7, 2);
    }

    // ── Status tag below score ────────────────────────────
    uint16_t stCol;
    if      (m.isLive)      stCol = C_GREEN;
    else if (m.isFinished)  stCol = C_DIM;
    else                    stCol = C_ACCENT;   // upcoming time in blue

    sprite.setTextColor(stCol, S_BG);
    sprite.drawString(m.status, 160, yCent + 10, 1);

    // ── Row divider (not after last row) ─────────────────
    if (i < fbMatchCount - 1) {
      sprite.drawFastHLine(6, yRow + rowH - 1, 308,
                           tft.color565(35, 35, 55));
    }
  }

  // ── Footer: last updated ─────────────────────────────────
  char upd[24];
  strftime(upd, sizeof(upd), "Updated %H:%M IST", &t);
  sprite.setTextDatum(MC_DATUM);
  sprite.setTextColor(C_DIM, S_BG);
  sprite.drawString(upd, 160, 224, 1);

  drawNavDots(sprite, 1);
  sprite.pushSprite(0, 0);
}

