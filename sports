// Try one competition. Returns true if ≥1 match found.
bool fetchFootballComp(const char* compCode, const char* compName) {
  WiFiClientSecure client;
  client.setInsecure();   // skip cert validation — fine for IoT data
  client.setTimeout(10);

  HTTPClient http;
  char url[160];
  // Fetch today's matches: LIVE + scheduled/finished for today
  snprintf(url, sizeof(url),
    "https://api.football-data.org/v4/competitions/%s/matches?status=LIVE,IN_PLAY,PAUSED,SCHEDULED,TIMED,FINISHED",
    compCode);

  http.begin(client, url);
  http.setTimeout(8000);
  http.addHeader("X-Auth-Token", FOOTBALL_KEY);
  int code = http.GET();

  Serial.printf("[FB] %s HTTP %d\n", compCode, code);

  if (code != 200) { http.end(); return false; }

  // Read into shared buffer — no String allocation
  int len = http.getStream().readBytes(httpBuf, HTTP_BUF - 1);
  httpBuf[len] = '\0';
  http.end();

  // Parse with ArduinoJson filter — only extract what we need
  StaticJsonDocument<128> filter;
  filter["matches"][0]["homeTeam"]["shortName"]       = true;
  filter["matches"][0]["awayTeam"]["shortName"]       = true;
  filter["matches"][0]["score"]["fullTime"]["home"]   = true;
  filter["matches"][0]["score"]["fullTime"]["away"]   = true;
  filter["matches"][0]["status"]                      = true;
  filter["matches"][0]["minute"]                      = true;
  filter["matches"][0]["utcDate"]                     = true;

  StaticJsonDocument<4096> doc;
  DeserializationError err = deserializeJson(doc, httpBuf,
                               DeserializationOption::Filter(filter));
  if (err) {
    Serial.printf("[FB] JSON error: %s\n", err.c_str());
    return false;
  }

  JsonArray arr = doc["matches"].as<JsonArray>();
  if (arr.isNull() || arr.size() == 0) return false;

  fbMatchCount = 0;

  // ── Pass 1: LIVE / IN_PLAY / PAUSED ──────────────────────
  for (JsonObject m : arr) {
    if (fbMatchCount >= FOOTBALL_MAX) break;
    const char* st = m["status"] | "";
    bool live = strcmp(st,"LIVE")==0 || strcmp(st,"IN_PLAY")==0 || strcmp(st,"PAUSED")==0;
    if (!live) continue;

    FootballMatch& fm = fbMatches[fbMatchCount++];
    strncpy(fm.home, m["homeTeam"]["shortName"] | "???", 12); fm.home[12]='\0';
    strncpy(fm.away, m["awayTeam"]["shortName"] | "???", 12); fm.away[12]='\0';
    fm.homeScore  = m["score"]["fullTime"]["home"] | 0;
    fm.awayScore  = m["score"]["fullTime"]["away"] | 0;
    fm.isLive     = true;
    fm.isFinished = false;
    int minute = m["minute"] | 0;
    if (strcmp(st,"PAUSED")==0)     snprintf(fm.status,sizeof(fm.status),"HT");
    else if (minute > 0)            snprintf(fm.status,sizeof(fm.status),"%d'",minute);
    else                            snprintf(fm.status,sizeof(fm.status),"LIVE");
  }

  // ── Pass 2: SCHEDULED / TIMED ────────────────────────────
  for (JsonObject m : arr) {
    if (fbMatchCount >= FOOTBALL_MAX) break;
    const char* st = m["status"] | "";
    if (strcmp(st,"SCHEDULED")!=0 && strcmp(st,"TIMED")!=0) continue;

    FootballMatch& fm = fbMatches[fbMatchCount++];
    strncpy(fm.home, m["homeTeam"]["shortName"] | "???", 12); fm.home[12]='\0';
    strncpy(fm.away, m["awayTeam"]["shortName"] | "???", 12); fm.away[12]='\0';
    fm.homeScore  = 0;
    fm.awayScore  = 0;
    fm.isLive     = false;
    fm.isFinished = false;

    // Extract HH:MM from utcDate and convert to IST (+5:30)
    const char* utc = m["utcDate"] | "";
    // utcDate format: "2025-06-18T15:00:00Z"
    int h=0, mi=0;
    if (strlen(utc) >= 16) {
      h  = (utc[11]-'0')*10 + (utc[12]-'0');
      mi = (utc[14]-'0')*10 + (utc[15]-'0');
      mi += 30; if(mi>=60){ mi-=60; h++; }
      h  +=  5; if(h >=24)  h -=24;
    }
    snprintf(fm.status, sizeof(fm.status), "%02d:%02d", h, mi);
  }

  // ── Pass 3: FINISHED ─────────────────────────────────────
  for (JsonObject m : arr) {
    if (fbMatchCount >= FOOTBALL_MAX) break;
    const char* st = m["status"] | "";
    if (strcmp(st,"FINISHED")!=0) continue;

    FootballMatch& fm = fbMatches[fbMatchCount++];
    strncpy(fm.home, m["homeTeam"]["shortName"] | "???", 12); fm.home[12]='\0';
    strncpy(fm.away, m["awayTeam"]["shortName"] | "???", 12); fm.away[12]='\0';
    fm.homeScore  = m["score"]["fullTime"]["home"] | 0;
    fm.awayScore  = m["score"]["fullTime"]["away"] | 0;
    fm.isLive     = false;
    fm.isFinished = true;
    snprintf(fm.status, sizeof(fm.status), "FT");
  }

  if (fbMatchCount > 0) {
    strncpy(fbCompName, compName, sizeof(fbCompName)-1);
    fbCompName[sizeof(fbCompName)-1] = '\0';
    Serial.printf("[FB] %s: %d matches\n", compName, fbMatchCount);
    return true;
  }
  return false;
}

void fetchFootball() {
  if (WiFi.status() != WL_CONNECTED) return;
  Serial.println("[FB] Fetching...");
  for (int i = 0; i < FB_COMP_CNT; i++) {
    if (fetchFootballComp(FB_COMPS[i], FB_NAMES[i])) {
      fbHasData = true;
      lastFbFetch = millis();
      return;
    }
  }
  // All failed or no matches today
  fbMatchCount = 0;
  fbHasData = true;   // mark as attempted so we show "no matches" not "loading"
  lastFbFetch = millis();
  Serial.println("[FB] No matches found in any competition");
}

